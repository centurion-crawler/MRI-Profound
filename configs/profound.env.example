# Required
MODEL=/path/to/Qwen3-VL-8B-Instruct
DATASETS="/path/to/train_a.jsonl /path/to/train_b.jsonl"
OUTPUT_DIR=outputs/profound

# Hardware/data sampling
CUDA_VISIBLE_DEVICES=0
NPROC_PER_NODE=1
MASTER_PORT=29510
VIDEO_MAX_PIXELS=50176
FPS_MAX_FRAMES=2

# Optional overrides
EPOCHS=2
LEARNING_RATE=2e-5
MAX_LENGTH=16384
GRAD_ACCUM=4
NUM_WORKERS=8
SAVE_STEPS=200
EVAL_STEPS=200

# Inference only
ADAPTER=/path/to/checkpoint
VAL_DATASET=/path/to/validation.jsonl
RESULT_PATH=outputs/validation_predictions.jsonl

